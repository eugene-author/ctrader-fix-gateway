# Copy to .env and fill in real values.
APP_ENV=dev
APP_NAME=ctrader-fix-gateway
APP_LOG_LEVEL=INFO

# Observability. SENTRY_DSN empty/unset disables
# METRICS_PORT is only bound by relay/projector/fix-worker - the api 
# process serves /metrics on its own HTTP port instead.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
METRICS_PORT=9100
OTEL_EXPORTER_OTLP_ENDPOINT=

DATABASE_USER=gateway
DATABASE_PASSWORD=gateway
DATABASE_NAME=gateway
DATABASE_URL=postgresql+asyncpg://gateway:gateway@postgres:5432/gateway

REDIS_URL=redis://redis:6379/0

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# fix-worker - needs a cTrader demo or real account
ACCOUNT_ID=
FIX_TRADE_HOST=
FIX_TRADE_PORT=5212
FIX_TRADE_SSL=true
FIX_TRADE_USERNAME=
FIX_TRADE_PASSWORD=
FIX_TRADE_SENDER_COMP_ID=
FIX_QUOTE_HOST=
FIX_QUOTE_PORT=5211
FIX_QUOTE_SSL=true
FIX_QUOTE_USERNAME=
FIX_QUOTE_PASSWORD=
FIX_QUOTE_SENDER_COMP_ID=
FIX_RECONNECT_MAX_DELAY=60
GRACEFUL_TIMEOUT=20
PRICE_TTL_SECONDS=60
REDIS_MAX_CONNECTIONS=200
QUOTE_SUBSCRIPTION_BATCH_SIZE=20
QUOTE_SUBSCRIPTION_BATCH_DELAY_SECONDS=0.1

# relay
OUTBOX_POLL_INTERVAL_SECONDS=0.1
OUTBOX_MAX_ATTEMPTS=10

# projector - fills trading constraints
SYMBOLS_OVERLAY_PATH=app/config/symbols.yaml

# api
PRICE_STALE_MS=5000
WS_MAX_SYMBOLS=50
WS_HEARTBEAT_SECONDS=15
RATE_LIMIT_ORDERS_PER_SECOND=10
RATE_LIMIT_ORDERS_BURST=20

# HMAC key for hashing API keys (app/core/api_keys.py)
# This placeholder is fine for a local/dev stack; generate a real one for prod
API_KEY_PEPPER=dev-pepper-change-me
